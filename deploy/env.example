# Reference of every variable deploy/docker-compose.yaml consumes.
# install/install.sh generates deploy/.env with real secrets (never commit
# it). For local dev, `make dev-up` seeds a throwaway .env from this shape.

# Edge
MAL_DOMAIN=exchange.example.com
MAL_ADMIN_DOMAIN=admin.exchange.example.com
# The first super-admin's login (installer bootstrap phase, issue #53).
# Its one-time password is generated per install — printed once and
# stored in the root-only credentials file, never in .env.
MAL_ADMIN_BOOTSTRAP_EMAIL=admin@exchange.example.com

# Postgres (one superuser for init/backups; one login role per service)
MAL_PG_SUPERUSER=malxchange
MAL_PG_SUPERUSER_PASSWORD=replace-me
MAL_PG_DATABASE=malxchange
MAL_PG_PASSWORD_API=replace-me
MAL_PG_PASSWORD_EXCHANGE=replace-me
MAL_PG_PASSWORD_MARKET=replace-me
MAL_PG_PASSWORD_WALLET=replace-me
MAL_PG_PASSWORD_ADMIN=replace-me

# Redpanda SASL (one app principal; SCRAM-SHA-256)
MAL_KAFKA_USER=malxchange
MAL_KAFKA_PASSWORD=replace-me

# Chain node RPC (btcd/ltcd, chains profile)
MAL_BTCD_RPCUSER=malxchange
MAL_BTCD_RPCPASSWORD=replace-me
MAL_LTCD_RPCUSER=malxchange
MAL_LTCD_RPCPASSWORD=replace-me
# EVM / TRON RPC (operator-supplied; unset = watch-only for the family)
MAL_EVM_RPC_URL=
MAL_EVM_RPC_FALLBACK_URL=
MAL_TRON_ENDPOINT=
MAL_TRON_API_KEY=
# BTC/LTC node RPC URLs (the chains profile sets these to the in-compose
# nodes; override for an external node). Unset = watch-only for the family.
MAL_BTCD_URL=
MAL_LTCD_URL=
# Wallet watcher: network (mainnet|simnet — must match the node), poll
# cadence, and whether to skip TLS verification on the chain nodes' certs.
# Fails closed: unset or empty means VERIFY (the safe default for external
# nodes with real certificates); "true" opts out for the in-compose nodes,
# which serve self-signed certs (the compose file defaults this to true for
# its own nodes — override to false here when pointing at external nodes).
MAL_WALLET_NET=
MAL_WALLET_POLL=
MAL_CHAIN_TLS_SKIP_VERIFY=
# Hot keystore file on the wallet host (created by cmd/walletctl during
# the key ceremony — see install/key-ceremony.md); unset = watch-only.
MAL_WALLET_KEYSTORE=
# api → admin-api internal-RPC origin for member content
# (announcements, help). Unset = api serves the content routes empty;
# compose sets http://admin-api:8080 (the admin-api backend service —
# the bare `admin` compose name is the admin SSR app).
MAL_API_ADMIN_BASE_URL=http://admin-api:8080

# api order path (issue #42): internal-RPC origins for the wallet freeze
# call (synchronous, before order.command is published), the market
# listing used to validate tick size / lot size / scale (cached for
# MAL_API_MARKET_CACHE_TTL), and the exchange's member-order current and
# history RPC. Defaults are the compose service names, so a compose
# install needs none of these set.
MAL_API_WALLET_BASE_URL=http://wallet:8080/internal
MAL_API_MARKET_BASE_URL=http://market:8080/internal
MAL_API_EXCHANGE_BASE_URL=http://exchange:8080/internal
MAL_API_MARKET_CACHE_TTL=5s

# Service-side secrets (consumed from issue #22 wallet onward)
MAL_PEPPER=replace-me
MAL_HOT_KEYSTORE_PASSPHRASE=replace-me

# api market-data proxy (#43): market's internal REST base URL (scheme,
# host, and the /internal prefix — the MAL_API_ADMIN_BASE_URL naming)
# and the bounded per-request budget — a down or slow market answers
# 503, never a hang (an unparsable timeout falls back to 5s).
MAL_API_MARKET_BASE_URL=http://market:8080/internal
MAL_API_MARKET_TIMEOUT=5s

# Member funds (#40): the wallet's internal RPC base URL (scheme, host,
# and the /internal prefix — the boot harness strips it, so the URL ends
# there) and the bounded per-request budget — an unreachable or slow
# wallet answers 503, never a hang.
MAL_API_WALLET_BASE_URL=http://wallet:8080/internal
MAL_API_WALLET_TIMEOUT=5s

# Backups
MAL_BACKUP_DIR=./backups
MAL_BACKUP_KEEP=14

# Member auth (issue #24, ADR-0006). SMTP empty = no outbound mail (the
# compose test profile points it at the mail sink); code TTL/cooldown and
# the failed-login lockout window are durations; the session TTL is the
# sliding expiry of a signed-in device.
MAL_API_SMTP_HOST=
MAL_API_SMTP_PORT=25
MAL_API_SMTP_USER=
MAL_API_SMTP_PASS=
MAL_API_SMTP_FROM=malxchange@localhost
MAL_API_CODE_TTL=5m
MAL_API_CODE_COOLDOWN=30s
MAL_API_LOCKOUT_WINDOW=15m
MAL_API_SESSION_TTL=168h
# Queued outbound WebSocket messages per socket (ADR-0011): overflow
# closes that one socket; the client reconnects and re-bootstraps.
MAL_API_WS_BUFFER=256

# Employee auth (issue #53, ADR-0012): Employee sessions are
# absolute+idle — 12 h total lifetime, 30 min inactivity window, no
# remember-me — and 5 failed logins inside the lockout window lock the
# account. All durations.
MAL_ADMIN_SESSION_ABSOLUTE=12h
MAL_ADMIN_SESSION_IDLE=30m
MAL_ADMIN_LOCKOUT_WINDOW=15m

# Config editors (issue #61): the admin-api internal-RPC origins for
# the wallet's Coin config RPC and the exchange's Market-config +
# engine-status RPCs (scheme, host, and the /internal prefix — the
# MAL_API_*_BASE_URL naming), plus the bounded per-request budget — a
# down or slow upstream answers 502, never a hang. Defaults are the
# compose service names, so a compose install needs none of these set.
MAL_ADMIN_WALLET_BASE_URL=http://wallet:8080/internal
MAL_ADMIN_WALLET_TIMEOUT=5s
MAL_ADMIN_EXCHANGE_BASE_URL=http://exchange:8080/internal
MAL_ADMIN_EXCHANGE_TIMEOUT=5s

# Wallet Ops upstream (issue #60): where wallet's internal RPC lives and
# how long one proxied custody call may take. The URL carries the
# /internal suffix (the boot harness strips it; the compose network is
# the auth boundary — it never crosses Caddy). The variable is shared
# with #61's Coin editor and #59's funds surface (withdrawal audit
# queue, manual balance adjustment) — single source, one line.
# api's internal RPC (issues #58/#62): the member/KYC surfaces and the
# Code channel surface all proxy it (prefix-free paths append, so the
# base carries /internal); one proxied call's budget.
MAL_ADMIN_API_BASE_URL=http://api:8080/internal
MAL_ADMIN_API_TIMEOUT=5s
